    "review::.::holistic::test_strategy::crud_test_coupling": {
      "id": "review::.::holistic::test_strategy::crud_test_coupling",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "CRUD unit tests are tightly coupled to Supabase client internals",
      "detail": {
        "holistic": true,
        "dimension": "test_strategy",
        "related_files": [
          "tests/unit/cowabunga_api/data/test_crud_base.py",
          "tests/unit/cowabunga_api/data/test_crud_api_key.py",
          "tests/mocks/mock_session.py"
        ],
        "evidence": [
          "test_crud_base.py asserts on mock_session.table(...).insert().execute() call chains",
          "test_crud_api_key.py uses mock_session.table().insert().execute() to verify behavior",
          "Changing the underlying DB client (e.g., from Supabase to Turso) would break these tests even if behavior is identical"
        ],
        "suggestion": "Refactor CRUD tests to assert on outcomes (return values, raised exceptions) rather than internal Supabase API call sequences, or introduce a repository port/interface to decouple tests from client specifics",
