      "tier": 1,
      "confidence": "high",
      "summary": "CRUD subclasses use inconsistent filter types: some typed models, some raw dicts",
      "detail": {
        "holistic": true,
        "dimension": "api_surface_coherence",
        "related_files": [
          "src/cowabunga_api/data/crud_assistant.py",
