      "detail": {
        "holistic": true,
        "dimension": "type_safety",
        "related_files": [
          "legacy/cowabunga_api/typedef/common.py",
          "legacy/cowabunga_api/backend/grpc_client.py"
        ],
        "evidence": [
          "common.py:22-25: completion_tokens: int | None = Field(default=DEFAULT_MAX_COMPLETION_TOKENS) - omitting the field reports 4096 generated tokens.",
          "grpc_client.py:159: create_embeddings builds Usage(prompt_tokens=0, total_tokens=0), which silently yields completion_tokens=4096 in embedding responses; the Optional annotation also invites omission."
