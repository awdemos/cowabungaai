    "review::.::holistic::initialization_coupling::lifespan-yields-before-configs-loaded": {
      "id": "review::.::holistic::initialization_coupling::lifespan-yields-before-configs-loaded",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "FastAPI lifespan yields before the config watcher loads anything; tokens.py then 500s on config.models['text-embeddings']",
      "detail": {
        "holistic": true,
        "dimension": "initialization_coupling",
        "related_files": [
          "legacy/cowabunga_api/main.py",
          "legacy/cowabunga_api/routers/cowabunga/tokens.py",
          "legacy/cowabunga_api/routers/cowabunga/count.py"
        ],
        "evidence": [
          "main.py:50-51 creates config_task = asyncio.create_task(config.watch_and_load_configs()) and immediately yields, so requests are served before load_all_configs() has run inside the task.",
          "tokens.py:22 does config.models['text-embeddings'] with no guard, producing an unhandled KeyError (HTTP 500) if a request arrives first.",
          "Sibling count.py:22-27 calls model_config.get_model_backend() and raises a clean HTTPException 404 for the identical not-yet-loaded condition, showing the race is handled unevenly across routers."
        ],
