    "review::.::holistic::design_coherence::turso_auth_mixed_responsibilities": {
      "id": "review::.::holistic::design_coherence::turso_auth_mixed_responsibilities",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "TursoAuthClient combines three authentication strategies with user management and session handling",
      "detail": {
        "holistic": true,
        "dimension": "design_coherence",
        "related_files": [
          "src/cowabunga_api/data/database/turso_auth.py"
        ],
        "evidence": [
          "Single class implements API key auth (_authenticate_api_key), JWT auth (_authenticate_jwt), session auth (_authenticate_session), user creation (create_user), and password sign-in (sign_in) across 371 LOC",
          "set_session both stores tokens in memory and writes to the database",
          "create_api_key generates tokens and persists hashes, mixing cryptography with storage"
        ],
        "suggestion": "Decompose into focused classes: Authenticator (JWT, API key, session strategies), UserService (create_user, sign_in), and SessionStore. Each should have a single responsibility.",
