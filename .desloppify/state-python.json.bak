    "review::.::holistic::error_consistency::data_layer_mixed_strategies": {
      "id": "review::.::holistic::error_consistency::data_layer_mixed_strategies",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "Data layer mixes raise, return None, return False, and Result-type error strategies",
      "detail": {
        "holistic": true,
        "dimension": "error_consistency",
        "related_files": [
          "src/cowabunga_api/data/crud_base.py",
          "src/cowabunga_api/data/crud_run.py",
          "src/cowabunga_api/data/database/turso_client.py"
        ],
        "evidence": [
          "crud_base.py: create() raises on Exception, get() returns None on IndexError, delete() returns False on Exception",
          "crud_run.py: update() returns None when response is empty instead of raising",
          "turso_client.py: execute() returns TursoResult(data=[], error=str(e)) instead of raising, diverging from Supabase client behavior"
        ],
        "suggestion": "Choose a single error strategy for the data layer: either raise domain exceptions for all failures, or consistently return a Result type. Do not mix both across sibling modules.",
        "reasoning": "",
        "summary_hash": "567cd7c6"
      },
