    "review::.::holistic::api_surface_coherence::database_client_api_divergence": {
      "id": "review::.::holistic::api_surface_coherence::database_client_api_divergence",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Database client backends expose unequal query surfaces and different factory parameter names",
      "detail": {
        "holistic": true,
        "dimension": "api_surface_coherence",
        "related_files": [
          "src/cowabunga_api/data/database/turso_client.py",
          "src/cowabunga_api/data/database/supabase_client.py",
          "src/cowabunga_api/data/database/base.py"
        ],
        "evidence": [
          "TursoQueryBuilder adds neq, gt, gte, lt, lte, order, limit, range beyond the QueryBuilder ABC",
          "SupabaseQueryBuilder only wraps the Supabase query object and does not expose the extra filter methods",
          "TursoClient.create(base_url, auth_token) vs SupabaseClient.create(supabase_url, supabase_key) \u2014 parameter names differ even though semantic roles are identical",
          "Callers depending on backend-specific query capabilities will fail silently when the factory returns the other backend"
        ],
        "suggestion": "Expand the QueryBuilder ABC to include the common filter methods, implement them for both backends, and align factory parameter names (e.g., url and key for both). Alternatively, document which query operations are backend-specific.",
        "reasoning": "",
        "summary_hash": "04a637f8"
      },
