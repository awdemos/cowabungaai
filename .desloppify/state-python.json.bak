      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "CRUDAPIKey.create generates cryptographic keys, mixing business logic with data access",
      "detail": {
        "holistic": true,
        "dimension": "design_coherence",
        "related_files": [
          "src/cowabunga_api/data/crud_api_key.py"
        ],
        "evidence": [
          "create() calls APIKey.generate() from backend.security.api_key (line 67)",
          "It also masks the returned key with a checksum formatter (line 113)",
