    "review::.::holistic::api_surface_coherence::sdk_dynamic_interface_dispatch": {
      "id": "review::.::holistic::api_surface_coherence::sdk_dynamic_interface_dispatch",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "SDK serve() and LLM decorator construct interfaces dynamically at runtime",
      "detail": {
        "holistic": true,
        "dimension": "api_surface_coherence",
        "related_files": [
          "src/cowabunga_sdk/serve.py",
          "src/cowabunga_sdk/llm.py"
        ],
        "evidence": [
          "serve(o, host='0.0.0.0', port=50051) uses hasattr(o, 'ChatComplete') to decide which gRPC services to register",
          "LLM decorator dynamically creates NewClass with ChatComplete, ChatCompleteStream, Complete, CompleteStream, CountTokens methods at runtime",
          "The effective public API of decorated classes is not statically discoverable; type checkers and IDEs cannot infer the generated interface"
        ],
        "suggestion": "Define an explicit Protocol or ABC that documents the required methods, and use isinstance checks against the protocol instead of hasattr. This makes the contract statically verifiable and improves IDE support for SDK consumers.",
