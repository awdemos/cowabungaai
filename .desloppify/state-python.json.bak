    "review::.::holistic::api_surface_coherence::missing_error_contracts": {
      "id": "review::.::holistic::api_surface_coherence::missing_error_contracts",
      "detector": "review",
      "file": ".",
      "tier": 2,
      "confidence": "medium",
      "summary": "Most route handlers do not document error conditions in docstrings despite raising HTTPExceptions",
      "detail": {
        "holistic": true,
        "dimension": "api_surface_coherence",
        "related_files": [
          "src/cowabunga_api/routers/openai/assistants.py",
          "src/cowabunga_api/routers/openai/threads.py",
          "src/cowabunga_api/routers/openai/messages.py",
          "src/cowabunga_api/routers/openai/vector_stores.py",
          "src/cowabunga_api/routers/openai/files.py",
          "src/cowabunga_api/routers/openai/runs.py",
          "src/cowabunga_api/backend/grpc_client.py"
        ],
        "evidence": [
          "create_assistant raises HTTPException with 400 and 500 status codes but docstring only says 'Create an assistant'",
          "create_thread raises HTTPException with 400 and 500 but docstring lacks Raises section",
          "Only modify_assistant in assistants.py includes a Raises section documenting HTTPException conditions",
          "grpc_client.py functions call gRPC stubs without documented failure modes or retry contracts",
          "Broad try/except Exception blocks wrap helper calls and re-raise as 500, but these error contracts are invisible to API consumers reading the docstrings"
        ],
        "suggestion": "Add Raises sections to all public route handler docstrings documenting the HTTPException conditions (status codes and triggers). Document gRPC client failure modes (connection errors, timeout behavior) in grpc_client.py.",
